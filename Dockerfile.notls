## Cross-compiled build for amd64, arm64 and 32-bit ARM. pview is pure Rust
## (MQTT via rumqttc), so this and Dockerfile produce the same bridge; the
## "notls" name and image are kept for existing users.
####################################################################################################
## Builder
####################################################################################################
FROM --platform=$BUILDPLATFORM alpine:3.24 AS builder
ARG TARGETPLATFORM
RUN case "$TARGETPLATFORM" in \
      "linux/arm/v7") echo armv7-unknown-linux-musleabihf > /rust_target.txt ;; \
      "linux/arm/v6") echo arm-unknown-linux-musleabihf > /rust_target.txt ;; \
      "linux/amd64") echo x86_64-unknown-linux-musl > /rust_target.txt ;; \
      "linux/arm64") echo aarch64-unknown-linux-musl > /rust_target.txt ;; \
      *) echo "Do $TARGETPLATFORM"; exit 1 ;; \
    esac ; \
    echo "Building for $TARGETPLATFORM via $(cat /rust_target.txt)"
# gcc supplies `cc`, which links build scripts and the amd64 target; Alpine's
# clang stopped pulling it in after 3.21.
RUN apk --no-cache add clang gcc git curl rustup musl-dev lld
RUN rustup-init -y
ENV PATH=/root/.cargo/bin:$PATH
RUN rustup target add $(cat /rust_target.txt)

RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "1000" \
    "pview"

RUN mkdir -p /data && chown 1000:1000 /data

WORKDIR /work
COPY . .

RUN --mount=type=ssh \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/work/target \
    CC=clang cargo install --locked --target $(cat /rust_target.txt) --bin pview --path .

####################################################################################################
## Final image
####################################################################################################
FROM scratch

# Import from builder.
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group

COPY --from=builder --chown=1000:1000 /data /data

WORKDIR /app

COPY --from=builder /lib/ld-musl*.so* /usr/lib/libgcc*.so* /lib/
COPY --from=builder /root/.cargo/bin/pview ./

USER pview:pview
LABEL org.opencontainers.image.source="https://github.com/benbraun/pview"
ENV \
  PV_STATE_FILE=/data/pview-state.json \
  RUST_BACKTRACE=full \
  PATH=/app:$PATH

CMD ["/app/pview", "serve-mqtt"]


